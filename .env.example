# ---------------------------------------------------------------------------
# STE MABANIS — environment configuration
# Copy to `.env` (never committed) and fill in real values.
# Every value is consumed server-side through src/server/env.ts (zod-validated).
# ---------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project URL from Supabase dashboard → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
# Service role key — SERVER ONLY. Never expose to the browser; the client
# never talks to Supabase directly, everything goes through server functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SMTP / email (Nodemailer) ----------------------------------------------
# When SMTP_HOST is empty, emails are logged to the server console instead of
# sent (useful for local development). On Vercel use ports 465/587 (25 is
# blocked). Gmail app passwords, Mailgun, Resend SMTP, Mailjet… all work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STE MABANIS <contact@mabanis.com>"

# --- Application -------------------------------------------------------------
# Canonical public origin — used in email links and absolute URLs.
PUBLIC_URL=http://localhost:3000
# Domain used for realistic placeholder emails in the seed data
# (e.g. prenom.nom@mabanis.com).
SITE_DOMAIN=mabanis.com
# Build target: "node-server" (VPS / PM2) or "vercel".
DEPLOY_TARGET=node-server

# --- Seed script only --------------------------------------------------------
# Initial password for the staff auth users created by `bun run db:seed`.
SEED_STAFF_PASSWORD=change-me-before-seeding
